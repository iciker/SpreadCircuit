    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Absolute cross-venue price divergence. Sustained large values may indicate stale or incorrect market data rather than an executable opportunity.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "divergence",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 10,
            "gradientMode": "none",
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "insertNulls": false,
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": {
              "type": "linear"
            },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 2
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "id": 11,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "100 * abs(max by (job, instance, pair) (evm_price_usdc{job=~\"${job:regex}\",instance=~\"${instance:regex}\",pair=~\"${pair:regex}\",side=\"sell\"}) - max by (job, instance, pair) (hl_price_usdc{job=~\"${job:regex}\",instance=~\"${instance:regex}\",pair=~\"${pair:regex}\",side=\"ask\"})) / clamp_min(max by (job, instance, pair) (hl_price_usdc{job=~\"${job:regex}\",instance=~\"${instance:regex}\",pair=~\"${pair:regex}\",side=\"ask\"}), 1e-12)",
          "instant": false,
          "legendFormat": "{{pair}} buy route",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "100 * abs(max by (job, instance, pair) (evm_price_usdc{job=~\"${job:regex}\",instance=~\"${instance:regex}\",pair=~\"${pair:regex}\",side=\"buy\"}) - max by (job, instance, pair) (hl_price_usdc{job=~\"${job:regex}\",instance=~\"${instance:regex}\",pair=~\"${pair:regex}\",side=\"bid\"})) / clamp_min(max by (job, instance, pair) (hl_price_usdc{job=~\"${job:regex}\",instance=~\"${instance:regex}\",pair=~\"${pair:regex}\",side=\"bid\"}), 1e-12)",
          "instant": false,
          "legendFormat": "{{pair}} sell route",
          "range": true,
          "refId": "B"
        }
      ],
      "title": "Cross-Venue Price Divergence",
      "type": "timeseries"
