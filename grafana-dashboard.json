        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "evm_price_usdc{job=~\"${job:regex}\",instance=~\"${instance:regex}\",pair=~\"${pair:regex}\",side=\"buy\"}",
          "instant": false,
          "legendFormat": "{{pair}} EVM buy",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
