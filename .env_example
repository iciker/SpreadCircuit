# ============================================================
# SpreadCircuit 套利机器人配置示例
# 复制为 .env 并填入真实值后使用
#
# 添加新交易对只需：
#   1. 在 PAIRS 中加入前缀（如 PAIRS=HYPE,PURR,HFUN）
#   2. 添加对应的 {PREFIX}_* 环境变量块
#   无需修改任何 Rust 代码
#
# HyperLiquid spot_coin 格式说明：
#   有名字的市场（如 PURR/USDC）用 token 名称：PURR
#   无名字的市场用 @index（来自 spotMeta universe[i].name）：@1, @59, @107...
# ============================================================

# ==================== 运行模式 ====================
RUST_LOG=info
DRY_RUN=true       # true=只记录不执行（安全模式），false=实盘交易
# DRY_RUN=false 时还必须显式设置：
# LIVE_TRADING_ACK=I_UNDERSTAND_THE_RISK

# ==================== 钱包配置 ====================
PRIVATE_KEY=你的私钥（不含 0x 前缀）

# ==================== 活跃交易对 ====================
# 逗号分隔，每个名称对应下方的 {NAME}_* 变量块
PAIRS=HYPE,PURR

# ==================== HYPE/USDC 交易对 ====================
HYPE_TOKEN0="0xb8ce59fc3717ada4c02eadf9682a9e934f625ebb"  # USDC
HYPE_DECIMALS0=6
HYPE_TOKEN1="0x5555555555555555555555555555555555555555"  # WHYPE
HYPE_DECIMALS1=18
HYPE_SYMBOL=HYPE
HYPE_SPOT_COIN=@107          # spotMeta universe[105].name="@107"
HYPE_ORDER_AMOUNT=0.6        # 单笔下单量（token1/WHYPE 计价，如 0.6 = 0.6 WHYPE）
HYPE_FEE_TIER=500            # Uniswap V3 fee tier: 500=0.05%
HYPE_ASK_DIFF_PERCENT=36     # buy_diff 额外人工触发阈值（bps），程序还会校验动态经济硬下限
HYPE_BID_DIFF_PERCENT=36     # sell_diff 额外人工触发阈值（bps），程序还会校验动态经济硬下限
HYPE_ENABLE_SELL_ARB=false   # 是否开启 sell_diff 双向套利（建议先 dry_run 验证后再开启）
# HYPE_USE_HYPERSWAP=true    # 可选，默认 true（HYPE/USDC 在 HyperSwap 有池）
# HYPE_USE_KITTEN=true       # 可选，默认 true（受全局 KITTEN_QUOTER 是否配置控制）
# HYPE_MIN_OUT_BPS=30        # 可选，继承全局 MIN_OUT_BPS
# HYPE_LIMIT_SLIPPAGE=21     # 可选，继承全局 LIMIT_SLIPPAGE

# ==================== PURR/USDC 交易对 ====================
PURR_TOKEN0="0xb8ce59fc3717ada4c02eadf9682a9e934f625ebb"  # USDC
PURR_DECIMALS0=6
PURR_TOKEN1="0x9b498C3c8A0b8CD8BA1D9851d40D186F1872b44E"  # PURR
PURR_DECIMALS1=18
PURR_SYMBOL=PURR
PURR_SPOT_COIN=PURR          # spotMeta universe[0].name="PURR/USDC"，用 token 名称
PURR_ORDER_AMOUNT=500        # 单笔下单量（token1/PURR 计价）
PURR_FEE_TIER=3000           # 0.3%
PURR_ASK_DIFF_PERCENT=50
PURR_BID_DIFF_PERCENT=50
PURR_ENABLE_SELL_ARB=false   # 是否开启 sell_diff 双向套利
PURR_USE_HYPERSWAP=false     # PURR/USDC 在 HyperSwap 无池，关闭避免每块 WARN
PURR_USE_KITTEN=false        # PURR/USDC 在 KittenSwap 无池（KittenSwap 只有 PURR/HYPE）
PURR_MIN_OUT_BPS=50          # PURR 流动性差，单独设置

# ==================== HFUN/USDC 交易对（示例）====================
# HFUN_TOKEN0="0xb8ce59fc3717ada4c02eadf9682a9e934f625ebb"  # USDC
# HFUN_DECIMALS0=6
# HFUN_TOKEN1="0xa320D9f65ec992EfF38622c63627856382Db726c"  # HFUN
# HFUN_DECIMALS1=18
# HFUN_SYMBOL=HFUN
# HFUN_SPOT_COIN=@1           # spotMeta universe[1].name="@1"
# HFUN_ORDER_AMOUNT=50
# HFUN_FEE_TIER=3000
# HFUN_ASK_DIFF_PERCENT=80
# HFUN_BID_DIFF_PERCENT=80
# HFUN_MIN_OUT_BPS=80

# ==================== CATBAL/USDC 交易对（示例）====================
# CATBAL_TOKEN0="0xb8ce59fc3717ada4c02eadf9682a9e934f625ebb"
# CATBAL_DECIMALS0=6
# CATBAL_TOKEN1="0x11735dBd0B97CfA7Accf47d005673BA185f7fd49"  # CATBAL
# CATBAL_DECIMALS1=18
# CATBAL_SYMBOL=CATBAL
# CATBAL_SPOT_COIN=@59        # spotMeta universe[59].name="@59"
# CATBAL_ORDER_AMOUNT=1000
# CATBAL_FEE_TIER=3000
# CATBAL_ASK_DIFF_PERCENT=100
# CATBAL_BID_DIFF_PERCENT=100

# ==================== UBTC/USDC 交易对（示例）====================
# UBTC_TOKEN0="0xb8ce59fc3717ada4c02eadf9682a9e934f625ebb"
# UBTC_DECIMALS0=6
# UBTC_TOKEN1="0x9FDBdA0A5e284c32744D2f17Ee5c74B284993463"  # UBTC
# UBTC_DECIMALS1=8
# UBTC_SYMBOL=UBTC
# UBTC_SPOT_COIN=@142         # spotMeta universe[140].name="@142"
# UBTC_ORDER_AMOUNT=0.001
# UBTC_FEE_TIER=500
# UBTC_ASK_DIFF_PERCENT=30
# UBTC_BID_DIFF_PERCENT=30

# ==================== UETH/USDC 交易对（示例）====================
# UETH_TOKEN0="0xb8ce59fc3717ada4c02eadf9682a9e934f625ebb"
# UETH_DECIMALS0=6
# UETH_TOKEN1="0xBe6727B535545C67d5cAa73dEa54865B92CF7907"  # UETH
# UETH_DECIMALS1=18
# UETH_SYMBOL=UETH
# UETH_SPOT_COIN=@151         # spotMeta universe[147].name="@151"
# UETH_ORDER_AMOUNT=0.03
# UETH_FEE_TIER=500
# UETH_ASK_DIFF_PERCENT=30
# UETH_BID_DIFF_PERCENT=30

# ==================== 全局成本参数（所有 pair 共享）====================
LIQUID_FEE_BPS=1             # 交易所手续费
GAS_COST_USDC=0.02           # 单次链上 Gas 成本估值（USDC，与订单名义金额同单位）
PROFIT_BUFFER_BPS=12         # 盈利安全边际
MIN_OUT_BPS=30               # EVM swap 最小输出容忍（全局默认）
LIMIT_SLIPPAGE=21            # Liquid 下单价格偏移（全局默认）

# ==================== RPC 节点配置 ====================
HTTPS_RPC="https://rpc.hyperliquid.xyz/evm"
WSS_RPC="wss://你的WebSocket节点地址/evm"    # 必须支持 eth_subscribe(newHeads)，自建验证见 README
WSS_API="wss://api.hyperliquid.xyz/ws"

# ==================== DEX 合约地址（无需修改）====================
HYPERSWAP_ROUTER01="0x4e2960a8cd19b467b82d26d83facb0fae26b094d"  # HyperSwap V3 SwapRouter（来自 hyperevmscan.io/address/0x4e2960...）
HYPERSWAP_QUOTEV2="0x03A918028f22D9E1473B7959C927AD7425A45C7C"
PRJX_QUOTEV2="0x239F11a7A3E08f2B8110D4CA9F6B95d4c8865258"
PRJX_ROUTERV2="0x1EbDFC75FfE3ba3de61E7138a3E8706aC841Af9B"
KITTEN_QUOTER="0x3aA96eDb755C44F3E50C5408a36abb52f28326Ba"
KITTEN_ROUTER="0x4e73E421480a7E0C24fB3c11019254edE194f736"  # Algebra Integral SwapRouter（来自 docs.kittenswap.finance/tokenomics/deployed-contracts）

# ==================== Prometheus 监控 ====================
METRICS_PORT=9090
METRICS_HOST=127.0.0.1      # 0.0.0.0 = 允许远程抓取
LOG_DIR=logs
DB_PATH=data.db              # SQLite 价格记录数据库路径
DB_MAX_PRICE_ROWS=1000000    # 最多保留的价格记录行数，超出后删除最旧数据
